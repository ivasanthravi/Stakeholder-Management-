# Copy to .env and adjust. Never commit .env.

# Public origin the browser uses. Development: the Vite dev server.
APP_URL=http://localhost:5173
# API port in development (the Vite dev server proxies /api here). In production PORT is used instead.
API_PORT=8787

# Postgres connection string. Leave unset in development to use the embedded PGlite database in PGLITE_DIR.
# Required in production.
# DATABASE_URL=postgres://user:password@host:5432/meridian
PGLITE_DIR=.data/pglite

# 32+ random characters, e.g. `openssl rand -base64 48`. Required in production.
# AUTH_SECRET=

# Require email verification before sign-in (recommended: true).
REQUIRE_EMAIL_VERIFICATION=true

# Mail transport: `log` stores mail in the dev outbox (/dev/mail) and the server log (nothing is sent); `postmark` delivers.
MAIL_TRANSPORT=log

# Development seed only.
# SEED_PASSWORD=meridian-sample-2026
# SEED_PEOPLE=184

# ── AI layer (Phase 2) ──────────────────────────────────────────────────────
# With no key, every AI feature runs on the built-in rules engine: deterministic, no data leaves the server.
# Before processing real customer information with a model, review the provider's data handling and
# retention terms (docs/ai/security-and-privacy.md).
# ANTHROPIC_API_KEY=
# Force an engine: `local` (rules only) or `claude`. Default: claude when a key is set, else local.
# AI_ENGINE=local
# Model for the claude engine (default claude-opus-5-5; see docs/ai/model-strategy.md).
# AI_MODEL=claude-opus-5-5
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# MAIL_FROM=Meridian <no-reply@your-verified-domain.example>
# Where website contact-form enquiries go (form returns 503 until set).
# SALES_EMAIL=sales@your-domain.example

# ── Billing (Phase 3) ───────────────────────────────────────────────────────
# stripe | paddle | simulator (development only) | none. Default: simulator in development, none in production.
# BILLING_PROVIDER=simulator
# Live (non-test) provider keys are refused unless this is "true" — explicit approval for real charges.
# BILLING_LIVE_APPROVED=false
# Provider price ids per plan and interval. Unset combinations are not sold.
# BILLING_PRICE_STARTER_MONTHLY=
# BILLING_PRICE_STARTER_ANNUAL=
# BILLING_PRICE_PROFESSIONAL_MONTHLY=
# BILLING_PRICE_PROFESSIONAL_ANNUAL=
# Stripe (test keys start with sk_test_)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Paddle (sandbox or production)
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# Development simulator signing secret.
# SIMULATOR_WEBHOOK_SECRET=dev-only-simulator-secret

# ── Operations ──────────────────────────────────────────────────────────────
# Background worker + schedules in this process (set false on web-only replicas).
# JOBS_ENABLED=true
# Where workspace exports are written (must be persistent and private; default .data/exports).
# EXPORT_DIR=
# Comma-separated emails allowed to read /api/operator/metrics.
# OPERATOR_EMAILS=

# ── Production hardening (Phase 4) ──────────────────────────────────────────
# Client IP for rate limits behind a proxy. Either a header your platform sets and clients cannot forge
# (e.g. x-real-ip, fly-client-ip, cf-connecting-ip) ...
# CLIENT_IP_HEADER=
# ... or how many trusted proxies append to X-Forwarded-For (default 1), plus their addresses for the auth library.
# TRUSTED_PROXY_HOPS=1
# TRUSTED_PROXIES=
# Enables /api/metrics (Prometheus) for requests with "Authorization: Bearer <token>".
# METRICS_TOKEN=
# Requests per minute per IP across /api (default 600).
# API_RATE_LIMIT_PER_MINUTE=600
# Log format: JSON in production; set json to force it in development.
# LOG_FORMAT=json

# ── Environments (Phase 5) ──────────────────────────────────────────────────
# With NODE_ENV=production: `staging` (synthetic data, sandbox providers; live payments refused) or `production`
# (requires an https APP_URL and MAIL_TRANSPORT=postmark). Reported by /api/health.
# DEPLOY_ENV=production
# Production only: the Claude model engine stays off until this is "true" (data terms reviewed, live evaluation
# recorded). Never set ANTHROPIC_BASE_URL in production unless you intend to route model traffic elsewhere.
# AI_MODEL_APPROVED=false
# Who may sign up: open | invite_only (production default). Allow-list: addresses or @domains, comma-separated.
# SIGNUP_MODE=invite_only
# SIGNUP_ALLOWLIST=@your-company.example
# Sign-in/sign-up attempts per client IP per 10 s (offices behind one NAT share an IP).
# AUTH_RATE_LIMIT_PER_10S=3
